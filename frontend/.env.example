# Comein Frontend — 환경 변수 예시 (.env.local 로 복사해 사용)

# 백엔드(FastAPI) 베이스 URL. 프론트가 이 주소로 /api/chat · /api/summary 를 호출한다.
#  - 로컬 개발: 백엔드를 uvicorn 으로 띄운 주소
#  - 배포(Vercel): Render 등 백엔드 서비스의 공개 URL
# 미설정 시 상대경로("")로 폴백한다.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Supabase — 공유 일정 · 대화 · 로그인. 프론트가 직접 붙는다(RLS + Realtime).
# 둘 중 하나라도 비면 `isSupabaseConfigured` 가 false 가 되어, 앱은 저장도 로그인도 없이
# 로컬 스토어만으로 조용히 혼자 돈다 — 화면은 멀쩡해 보이므로 원인을 찾기 어렵다.
# (다른 컴퓨터에서 clone 하면 .env.local 은 따라오지 않는다. 여기 적어 두는 이유다.)
# 대시보드 → Project Settings → API 에서 복사:
#   Project URL      → NEXT_PUBLIC_SUPABASE_URL   (https://<ref>.supabase.co 형태)
#   anon public key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
