# Comein Frontend — 환경 변수 예시 (.env.local 로 복사해 사용)

# 백엔드(FastAPI) 베이스 URL. 프론트가 이 주소로 /api/chat · /api/summary 를 호출한다.
#  - 로컬 개발: 백엔드를 uvicorn 으로 띄운 주소
#  - 배포(Vercel): Render 등 백엔드 서비스의 공개 URL
# 미설정 시 상대경로("")로 폴백한다.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ⚠️ 개발할 때 브라우저 주소는 반드시 http://localhost:3000 으로 연다.
#
#    `127.0.0.1:3000` 과 `localhost:3000` 은 브라우저에게 **서로 다른 출처(origin)** 다.
#    백엔드의 CORS_ORIGINS 기본값은 localhost 뿐이라, 127.0.0.1 로 열면 /api/chat 이
#    preflight 에서 막힌다.
#
#    그런데 화면은 멀쩡히 돈다 — 캡처 바가 로컬 규칙으로 물러나 "AI 없이 정리했어요"
#    라고만 하기 때문이다. 그래서 "AI 가 갑자기 멍청해졌다" 로 보이지 원인이 CORS 인 줄
#    알기 어렵다(실제로 그렇게 한 번 헤맸다 — docs/24 §25).
#
#    127.0.0.1 로 열어야 한다면 백엔드 쪽에 그 출처를 함께 적는다:
#      backend/.env → CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase — 공유 일정 · 대화 · 로그인. 프론트가 직접 붙는다(RLS + Realtime).
# 둘 중 하나라도 비면 `isSupabaseConfigured` 가 false 가 되어, 앱은 저장도 로그인도 없이
# 로컬 스토어만으로 조용히 혼자 돈다 — 화면은 멀쩡해 보이므로 원인을 찾기 어렵다.
# (다른 컴퓨터에서 clone 하면 .env.local 은 따라오지 않는다. 여기 적어 두는 이유다.)
# 대시보드 → Project Settings → API 에서 복사:
#   Project URL      → NEXT_PUBLIC_SUPABASE_URL   (https://<ref>.supabase.co 형태)
#   anon public key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
