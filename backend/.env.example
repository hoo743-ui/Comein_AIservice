# Comein Backend 환경변수 예시 — 실제 .env 는 커밋 금지 (docs/14_SECURITY.md)
# 배포(Render) 시에는 같은 키를 대시보드 Environment 에 넣는다 (docs/15_DEPLOY.md)
ENV=development

# 프론트 출처 허용 목록 — 쉼표로 구분 (JSON 배열 표기도 허용)
CORS_ORIGINS=http://localhost:3000
# 매번 주소가 바뀌는 Vercel 프리뷰까지 허용할 때만 사용
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# DATABASE_URL 은 없다 — 이 서버는 DB 에 붙지 않는다.
# 저장·조회는 프론트가 Supabase 에 직접 한다(frontend/.env.local 의 NEXT_PUBLIC_SUPABASE_*).
# 여기가 하는 일은 자연어 파싱뿐이라 상태를 두지 않는다. 자세히는 docs/24 §16.

# 아직 쓰이는 곳이 없다 — 인증은 지금 Supabase Auth 가 프론트에서 맡는다.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ⚠️ 이 파일은 git 에 올라간다 — 실제 키는 절대 여기 두지 말 것.
#    로컬 값은 backend/.env, 배포 값은 Render Environment 탭에 넣는다.
GEMINI_API_KEY=
GROQ_API_KEY=
